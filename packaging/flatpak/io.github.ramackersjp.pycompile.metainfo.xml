<?xml version="1.0" encoding="UTF-8"?>
<component type="console-application">
  <id>io.github.ramackersjp.pycompile</id>
  <name>pycompile</name>
  <summary>Compile Python source files into standalone native binaries</summary>
  <description>
    <p>
      pycompile translates a supported subset of Python into C, invokes the system C
      compiler, and emits a single standalone native executable. No interpreter is
      required at run time.
    </p>
  </description>
